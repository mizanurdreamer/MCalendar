# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bookingcalendar?schema=public"

# JWT secrets (use long random strings in production)
JWT_ACCESS_SECRET="dev-access-secret-change-me-in-production-please-32chars"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me-in-production-please-32chars"

# Token lifetimes
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# App
NODE_ENV="development"

# Cron: Booking Data Fetch
CRON_BOOKING_DATA_FETCH_INTERVAL_MS=300000
BOOKING_DATA_FETCH_ENABLED="true"
CRON_FETCH_TIMEOUT_MS=30000
CRON_API_SECRET=""
