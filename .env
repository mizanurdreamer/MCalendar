# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/bookingcalendar?schema=public"

# JWT secrets (use long random strings in production)
JWT_ACCESS_SECRET="dev-access-secret-change-me-in-production-please-32chars"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me-in-production-please-32chars"

# Token lifetimes
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# App
NODE_ENV="development"

# SMS via Email (SMTP)
SMS_SMTP_HOST="smtp.emailsrvr.com"
SMS_SMTP_PORT=587
SMS_SMTP_SECURE=false
SMS_SMTP_USER="sahadat@placovu.com"
SMS_SMTP_PASS="Sahadat2024@@"
SMS_EMAIL_FROM="sahadat@placovu.com"
SMS_SMTP_TLS_SERVERNAME="secure.emailsrvr.com"
SMS_SMTP_TLS_REJECT_UNAUTHORIZED=true
# Cron: Booking Data Fetch
CRON_BOOKING_DATA_FETCH_SCHEDULE_IN_MINUTES=10
BOOKING_DATA_FETCH_ENABLED=true
CRON_API_SECRET=""
