generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  name      String   @id @db.VarChar(32)
  users     User[]
  createdAt DateTime @default(now())

  @@map("roles")
}

model User {
  id           String  @id @default(uuid()) @db.Uuid
  email        String  @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  roleId       String  @db.VarChar(32)
  role         Role    @relation(fields: [roleId], references: [name], onUpdate: Cascade)
  isActive     Boolean @default(true)

  clientProfile  ClientProfile?
  cleanerProfile CleanerProfile?

  refreshTokens      RefreshToken[]
  bookingEndpoints   ClientBookingEndpoint[]
  bookingFetchData   BookingFetchData[]   @relation("BookingFetchDataClient")
  guestBookingInfo      GuestBookingInfo[]      @relation("GuestBookingInfo")
  clientTaskSchedules   CleanerTaskSchedule[]   @relation("ClientTaskSchedules")
  cleanerTaskSchedules  CleanerTaskSchedule[]   @relation("CleanerTaskSchedules")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  deletedAt DateTime?

  @@index([roleId], map: "users_roleId_idx")
  @@index([deletedAt], map: "users_deletedAt_idx")
  @@map("users")
}

model ClientProfile {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName String?
  primaryContact String?
  portfolioSize Int?
  timezone String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.Uuid
  updatedBy String?  @db.Uuid
  deletedAt DateTime?

  @@index([deletedAt], map: "client_profiles_deletedAt_idx")
  @@map("client_profiles")
}

model CleanerProfile {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceArea String?
  hourlyRate Int?
  rating Decimal? @db.Decimal(4, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.Uuid
  updatedBy String?  @db.Uuid
  deletedAt DateTime?

  @@index([deletedAt], map: "cleaner_profiles_deletedAt_idx")
  @@map("cleaner_profiles")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId], map: "refresh_tokens_userId_idx")
  @@map("refresh_tokens")
}

model ClientBookingEndpoint {
  id       String  @id @default(uuid()) @db.Uuid
  clientId String  @db.Uuid
  client   User    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name     String
  url      String
  isActive Boolean @default(true)

  guestBookingInfo GuestBookingInfo[]
  fetchData        BookingFetchData[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  deletedAt DateTime?

  @@index([clientId], map: "ClientBookingEndpoints_clientId_idx")
  @@index([deletedAt], map: "ClientBookingEndpoints_deletedAt_idx")
  @@map("ClientBookingEndpoints")
}

model BookingFetchData {
  id         String                @id @default(uuid()) @db.Uuid
  endpointId String                @db.Uuid
  endpoint   ClientBookingEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  clientId   String                @db.Uuid
  client     User                  @relation("BookingFetchDataClient", fields: [clientId], references: [id], onDelete: Cascade)
  payloadHash String
  rawData    Json
  fetchedAt  DateTime              @default(now())

  items GuestBookingInfo[]

  @@unique([endpointId, payloadHash], map: "BookingFetchData_endpointId_payloadHash_key")
  @@index([endpointId], map: "BookingFetchData_endpointId_idx")
  @@index([clientId], map: "BookingFetchData_clientId_idx")
  @@index([fetchedAt], map: "BookingFetchData_fetchedAt_idx")
  @@map("BookingFetchData")
}

model GuestBookingInfo {
  id         String                @id @default(uuid()) @db.Uuid
  endpointId String                @db.Uuid
  endpoint   ClientBookingEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  clientId   String                @db.Uuid
  client     User                  @relation("GuestBookingInfo", fields: [clientId], references: [id], onDelete: Cascade)
  fetchDataId String               @db.Uuid
  fetchData   BookingFetchData     @relation(fields: [fetchDataId], references: [id], onDelete: Cascade)
  dedupeKey  String                @unique

  summary   String?
  startDate DateTime?
  endDate   DateTime?
  status    String?
  createdAt DateTime @default(now())

  @@index([endpointId], map: "GuestBookingInfo_endpointId_idx")
  @@index([clientId], map: "GuestBookingInfo_clientId_idx")
  @@index([fetchDataId], map: "GuestBookingInfo_fetchDataId_idx")
  @@map("GuestBookingInfo")
}

model CleanerTaskSchedule {
  id        String   @id @default(uuid()) @db.Uuid
  clientId  String   @db.Uuid
  cleanerId String   @db.Uuid
  client    User     @relation("ClientTaskSchedules", fields: [clientId], references: [id], onDelete: Cascade)
  cleaner   User     @relation("CleanerTaskSchedules", fields: [cleanerId], references: [id], onDelete: Cascade)

  startDate DateTime
  endDate   DateTime?
  isActive  Boolean  @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  deletedAt DateTime?

  @@unique([clientId, cleanerId, startDate], map: "CleanerTaskSchedules_clientId_cleanerId_startDate_key")
  @@index([clientId], map: "CleanerTaskSchedules_clientId_idx")
  @@index([cleanerId], map: "CleanerTaskSchedules_cleanerId_idx")
  @@index([startDate, endDate], map: "CleanerTaskSchedules_startDate_endDate_idx")
  @@index([deletedAt], map: "CleanerTaskSchedules_deletedAt_idx")
  @@map("CleanerTaskSchedules")
}
