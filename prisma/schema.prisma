generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id        String  @id @default(uuid()) @db.Uuid
  name      String  @unique
  users     User[]
  createdAt DateTime @default(now())

  @@map("role")
}

model User {
  id           String  @id @default(uuid()) @db.Uuid
  email        String
  passwordHash String
  displayName  String
  roleId       String  @db.Uuid
  role         Role    @relation(fields: [roleId], references: [id], onUpdate: Cascade)
  isActive     Boolean @default(true)
  isDeleted    Boolean @default(false)
  clientProfile  ClientProfile?
  cleanerProfile CleanerProfile?
  refreshTokens      RefreshToken[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  deletedAt DateTime?

  @@index([roleId], map: "user_roleId_idx")
  @@index([deletedAt], map: "user_deletedAt_idx")
  @@map("user")
}

model ClientProfile {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  Email     String
  firstName String
  lastName String
  smsGatewayId String? @db.Uuid
  smsGateway SmsGateway? @relation("ClientSmsGateway", fields: [smsGatewayId], references: [id], onDelete: SetNull)
  phoneNo  String
  companyName String?
  portfolioSize Int?
  timezone String?
  isDeleted    Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.Uuid
  updatedBy String?  @db.Uuid
  deletedAt DateTime?
  bookingEndpoints ClientBookingEndpoint[]
  bookingFetchDatas BookingFetchData[]
  guestBookingInfos GuestBookingInfo[]
  cleanerTaskSchedules CleanerTaskSchedule[]
  cleanerAvailabilities CleanerAvailability[]
  cleaners             CleanerProfile[]
  @@index([smsGatewayId], map: "clientProfile_smsGatewayId_idx")
  @@index([deletedAt], map: "clientProfile_deletedAt_idx")
  @@map("clientProfile")
}

model CleanerProfile {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId  String?  @db.Uuid
  client    ClientProfile? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  Email     String
  firstName String
  lastName String
  smsGatewayId String? @db.Uuid
  smsGateway SmsGateway? @relation("CleanerSmsGateway", fields: [smsGatewayId], references: [id], onDelete: SetNull)
  phoneNo  String
  serviceArea String?
  hourlyRate Int?
  rating Decimal? @db.Decimal(4, 2)
  isDeleted    Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.Uuid
  updatedBy String?  @db.Uuid
  deletedAt DateTime?
  cleanerTaskSchedules CleanerTaskSchedule[]
  availabilities       CleanerAvailability[]
  @@index([clientId], map: "cleanerProfile_clientId_idx")
  @@index([smsGatewayId], map: "cleanerProfile_smsGatewayId_idx")
  @@index([deletedAt], map: "cleanerProfile_deletedAt_idx")
  @@map("cleanerProfile")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId], map: "refreshToken_userId_idx")
  @@map("refreshToken")
}

model ClientBookingEndpoint {
  id       String  @id @default(uuid()) @db.Uuid
  clientId String  @db.Uuid
  client   ClientProfile    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name     String
  url      String
  isActive Boolean @default(true)

  guestBookingInfo GuestBookingInfo[]
  fetchData        BookingFetchData[]
  isDeleted    Boolean @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  deletedAt DateTime?

  @@index([clientId], map: "clientBookingEndpoint_clientId_idx")
  @@index([deletedAt], map: "clientBookingEndpoint_deletedAt_idx")
  @@map("clientBookingEndpoint")
}

model BookingFetchData {
  id         String                @id @default(uuid()) @db.Uuid
  endpointId String                @db.Uuid
  endpoint   ClientBookingEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  clientId   String                @db.Uuid
  client     ClientProfile        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  payloadHash String
  rawData    Json
  fetchedAt  DateTime              @default(now())

  items GuestBookingInfo[]

  @@unique([endpointId, payloadHash], map: "bookingFetchData_endpointId_payloadHash_key")
  @@index([endpointId], map: "bookingFetchData_endpointId_idx")
  @@index([clientId], map: "bookingFetchData_clientId_idx")
  @@index([fetchedAt], map: "bookingFetchData_fetchedAt_idx")
  @@map("bookingFetchData")
}

model GuestBookingInfo {
  id         String                @id @default(uuid()) @db.Uuid
  endpointId String                @db.Uuid
  endpoint   ClientBookingEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  clientId   String                @db.Uuid
  client     ClientProfile         @relation( fields: [clientId], references: [id], onDelete: Cascade)
  fetchDataId String               @db.Uuid
  fetchData   BookingFetchData     @relation(fields: [fetchDataId], references: [id], onDelete: Cascade)
  dedupeKey  String                @unique

  summary   String?
  startDate DateTime?
  endDate   DateTime?
  status    String?
  isDeleted    Boolean @default(false)
  createdAt DateTime @default(now())

  @@index([endpointId], map: "guestBookingInfo_endpointId_idx")
  @@index([clientId], map: "guestBookingInfo_clientId_idx")
  @@index([fetchDataId], map: "guestBookingInfo_fetchDataId_idx")
  @@map("guestBookingInfo")
}

model CleanerTaskSchedule {
  id        String   @id @default(uuid()) @db.Uuid
  clientId  String   @db.Uuid
  cleanerId String   @db.Uuid
  client    ClientProfile     @relation( fields: [clientId], references: [id], onDelete: Cascade)
  cleaner   CleanerProfile     @relation(fields: [cleanerId], references: [id], onDelete: Cascade)

  assignedDate DateTime
  status    Int @default(0)
  isSentSms Boolean  @default(false)
  smsSentDate DateTime?
  isActive  Boolean  @default(true)
  isDeleted    Boolean @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  deletedAt DateTime?

  @@unique([clientId, cleanerId, assignedDate], map: "cleanerTaskSchedule_clientId_cleanerId_assignedDate_key")
  @@index([clientId], map: "cleanerTaskSchedule_clientId_idx")
  @@index([cleanerId], map: "cleanerTaskSchedule_cleanerId_idx")
  @@index([status], map: "cleanerTaskSchedule_status_idx")
  @@index([assignedDate], map: "cleanerTaskSchedule_assignedDate_idx")
  @@index([isSentSms], map: "cleanerTaskSchedule_isSentSms_idx")
  @@index([deletedAt], map: "cleanerTaskSchedule_deletedAt_idx")
  @@map("cleanerTaskSchedule")
}

model CleanerAvailability {
  id        String   @id @default(uuid()) @db.Uuid
  clientId  String   @db.Uuid
  client    ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)
  cleanerId String   @db.Uuid
  cleaner   CleanerProfile @relation(fields: [cleanerId], references: [id], onDelete: Cascade)

  fromDate  DateTime
  toDate    DateTime?
  note      String?

  isActive  Boolean  @default(true)
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.Uuid
  updatedBy String?  @db.Uuid
  deletedAt DateTime?

  @@index([clientId], map: "cleanerAvailability_clientId_idx")
  @@index([cleanerId], map: "cleanerAvailability_cleanerId_idx")
  @@index([fromDate], map: "cleanerAvailability_fromDate_idx")
  @@index([deletedAt], map: "cleanerAvailability_deletedAt_idx")
  @@map("cleanerAvailability")
}

model SmsGateway {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  domain    String   @unique
  clientProfiles ClientProfile[] @relation("ClientSmsGateway")
  cleanerProfiles CleanerProfile[] @relation("CleanerSmsGateway")
  isActive  Boolean  @default(true)
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.Uuid
  updatedBy String?  @db.Uuid
  deletedAt DateTime?

  @@index([deletedAt], map: "smsGateway_deletedAt_idx")
  @@map("smsGateway")
}
