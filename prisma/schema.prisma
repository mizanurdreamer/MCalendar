generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  name      String   @id @db.VarChar(32)
  users     User[]
  createdAt DateTime @default(now())

  @@map("roles")
}

model User {
  id           String  @id @default(uuid()) @db.Uuid
  email        String  @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  roleId       String  @db.VarChar(32)
  role         Role    @relation(fields: [roleId], references: [name], onUpdate: Cascade)
  isActive     Boolean @default(true)

  clientProfile  ClientProfile?
  cleanerProfile CleanerProfile?

  refreshTokens      RefreshToken[]
  bookingEndpoints   ClientBookingEndpoint[]
  clientBookingData  ClientBookingData[] @relation("ClientBookingData")
  clientAssignments  CleanerAssignment[] @relation("ClientAssignments")
  cleanerAssignments CleanerAssignment[] @relation("CleanerAssignments")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  deletedAt DateTime?

  @@index([roleId], map: "users_roleId_idx")
  @@index([deletedAt], map: "users_deletedAt_idx")
  @@map("users")
}

model ClientProfile {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName String?
  primaryContact String?
  portfolioSize Int?
  timezone String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.Uuid
  updatedBy String?  @db.Uuid
  deletedAt DateTime?

  @@index([deletedAt], map: "client_profiles_deletedAt_idx")
  @@map("client_profiles")
}

model CleanerProfile {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceArea String?
  hourlyRate Int?
  rating Decimal? @db.Decimal(4, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.Uuid
  updatedBy String?  @db.Uuid
  deletedAt DateTime?

  @@index([deletedAt], map: "cleaner_profiles_deletedAt_idx")
  @@map("cleaner_profiles")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId], map: "refresh_tokens_userId_idx")
  @@map("refresh_tokens")
}

model ClientBookingEndpoint {
  id       String  @id @default(uuid()) @db.Uuid
  clientId String  @db.Uuid
  client   User    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name     String
  url      String
  isActive Boolean @default(true)

  bookingData ClientBookingData[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  deletedAt DateTime?

  @@index([clientId], map: "ClientBookingEndpoints_clientId_idx")
  @@index([deletedAt], map: "ClientBookingEndpoints_deletedAt_idx")
  @@map("ClientBookingEndpoints")
}

model ClientBookingData {
  id         String                @id @default(uuid()) @db.Uuid
  endpointId String                @db.Uuid
  endpoint   ClientBookingEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  clientId   String                @db.Uuid
  client     User                  @relation("ClientBookingData", fields: [clientId], references: [id], onDelete: Cascade)

  rawData   Json
  fetchedAt DateTime @default(now())
  summary   String?
  startDate DateTime?
  endDate   DateTime?
  status    String?
  createdAt DateTime @default(now())

  @@index([endpointId], map: "ClientBookingData_endpointId_idx")
  @@index([clientId], map: "ClientBookingData_clientId_idx")
  @@index([fetchedAt], map: "ClientBookingData_fetchedAt_idx")
  @@map("ClientBookingData")
}

model CleanerAssignment {
  id        String   @id @default(uuid()) @db.Uuid
  clientId  String   @db.Uuid
  cleanerId String   @db.Uuid
  client    User     @relation("ClientAssignments", fields: [clientId], references: [id], onDelete: Cascade)
  cleaner   User     @relation("CleanerAssignments", fields: [cleanerId], references: [id], onDelete: Cascade)

  startDate DateTime
  endDate   DateTime?
  isActive  Boolean  @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  deletedAt DateTime?

  @@unique([clientId, cleanerId, startDate], map: "CleanerAssignments_clientId_cleanerId_startDate_key")
  @@index([clientId], map: "CleanerAssignments_clientId_idx")
  @@index([cleanerId], map: "CleanerAssignments_cleanerId_idx")
  @@index([startDate, endDate], map: "CleanerAssignments_startDate_endDate_idx")
  @@index([deletedAt], map: "CleanerAssignments_deletedAt_idx")
  @@map("CleanerAssignments")
}
