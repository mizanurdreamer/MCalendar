generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id        String  @id @default(uuid()) @db.Uuid
  name      String  @unique
  users     User[]
  createdAt DateTime @default(now())

  @@map("role")
}

model User {
  id           String  @id @default(uuid()) @db.Uuid
  email        String
  passwordHash String
  displayName  String
  roleId       String  @db.Uuid
  role         Role    @relation(fields: [roleId], references: [id], onUpdate: Cascade)
  isActive     Boolean @default(true)
  isDeleted    Boolean @default(false)
  clientProfile  ClientProfile?
  roomAttendantProfile RoomAttendantProfile?
  refreshTokens      RefreshToken[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  deletedAt DateTime?

  @@index([roleId], map: "user_roleId_idx")
  @@index([deletedAt], map: "user_deletedAt_idx")
  @@map("user")
}

model ClientProfile {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  Email     String
  firstName String
  lastName String
  smsGatewayId String? @db.Uuid
  smsGateway SmsGateway? @relation("ClientSmsGateway", fields: [smsGatewayId], references: [id], onDelete: SetNull)
  phoneNo  String
  companyName String?
  portfolioSize Int?
  timezone String?
  isDeleted    Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.Uuid
  updatedBy String?  @db.Uuid
  deletedAt DateTime?
  bookingEndpoints ClientBookingEndpoint[]
  bookingFetchDatas BookingFetchData[]
  guestBookingInfos GuestBookingInfo[]
  roomAttendantTaskSchedules RoomAttendantTaskSchedule[]
  roomAttendantAvailabilities RoomAttendantAvailability[]
  roomAttendants             RoomAttendantProfile[]
  @@index([smsGatewayId], map: "clientProfile_smsGatewayId_idx")
  @@index([deletedAt], map: "clientProfile_deletedAt_idx")
  @@map("clientProfile")
}

model RoomAttendantProfile {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId  String?  @db.Uuid
  client    ClientProfile? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  Email     String
  firstName String
  lastName String
  smsGatewayId String? @db.Uuid
  smsGateway SmsGateway? @relation("RoomAttendantSmsGateway", fields: [smsGatewayId], references: [id], onDelete: SetNull)
  phoneNo  String
  serviceArea String?
  hourlyRate Int?
  rating Decimal? @db.Decimal(4, 2)
  isDeleted    Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.Uuid
  updatedBy String?  @db.Uuid
  deletedAt DateTime?
  roomAttendantTaskSchedules RoomAttendantTaskSchedule[]
  availabilities       RoomAttendantAvailability[]
  @@index([clientId], map: "roomAttendantProfile_clientId_idx")
  @@index([smsGatewayId], map: "roomAttendantProfile_smsGatewayId_idx")
  @@index([deletedAt], map: "roomAttendantProfile_deletedAt_idx")
  @@map("roomAttendantProfile")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId], map: "refreshToken_userId_idx")
  @@map("refreshToken")
}

model ClientBookingEndpoint {
  id       String  @id @default(uuid()) @db.Uuid
  clientId String  @db.Uuid
  client   ClientProfile    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name     String
  url      String
  isActive Boolean @default(true)

  guestBookingInfo GuestBookingInfo[]
  fetchData        BookingFetchData[]
  isDeleted    Boolean @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  deletedAt DateTime?

  @@index([clientId], map: "clientBookingEndpoint_clientId_idx")
  @@index([deletedAt], map: "clientBookingEndpoint_deletedAt_idx")
  @@map("clientBookingEndpoint")
}

model BookingFetchData {
  id         String                @id @default(uuid()) @db.Uuid
  endpointId String                @db.Uuid
  endpoint   ClientBookingEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  clientId   String                @db.Uuid
  client     ClientProfile        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  payloadHash String
  rawData    Json
  fetchedAt  DateTime              @default(now())

  items GuestBookingInfo[]

  @@unique([endpointId, payloadHash], map: "bookingFetchData_endpointId_payloadHash_key")
  @@index([endpointId], map: "bookingFetchData_endpointId_idx")
  @@index([clientId], map: "bookingFetchData_clientId_idx")
  @@index([fetchedAt], map: "bookingFetchData_fetchedAt_idx")
  @@map("bookingFetchData")
}

model GuestBookingInfo {
  id         String                @id @default(uuid()) @db.Uuid
  endpointId String                @db.Uuid
  endpoint   ClientBookingEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  clientId   String                @db.Uuid
  client     ClientProfile         @relation( fields: [clientId], references: [id], onDelete: Cascade)
  fetchDataId String               @db.Uuid
  fetchData   BookingFetchData     @relation(fields: [fetchDataId], references: [id], onDelete: Cascade)
  dedupeKey  String                @unique

  summary   String?
  startDate DateTime?
  endDate   DateTime?
  status    String?
  isDeleted    Boolean @default(false)
  createdAt DateTime @default(now())

  @@index([endpointId], map: "guestBookingInfo_endpointId_idx")
  @@index([clientId], map: "guestBookingInfo_clientId_idx")
  @@index([fetchDataId], map: "guestBookingInfo_fetchDataId_idx")
  @@map("guestBookingInfo")
}

model RoomAttendantTaskSchedule {
  id        String   @id @default(uuid()) @db.Uuid
  clientId  String   @db.Uuid
  roomAttendantId String   @db.Uuid
  client    ClientProfile     @relation( fields: [clientId], references: [id], onDelete: Cascade)
  roomAttendant   RoomAttendantProfile     @relation(fields: [roomAttendantId], references: [id], onDelete: Cascade)

  assignedDate DateTime
  status    Int @default(0)
  isSentSms Boolean  @default(false)
  smsSentDate DateTime?
  isActive  Boolean  @default(true)
  isDeleted    Boolean @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  deletedAt DateTime?

  @@unique([clientId, roomAttendantId, assignedDate], map: "taskSchedule_clientId_roomAttendantId_assignedDate_key")
  @@index([clientId], map: "roomAttendantTaskSchedule_clientId_idx")
  @@index([roomAttendantId], map: "roomAttendantTaskSchedule_roomAttendantId_idx")
  @@index([status], map: "roomAttendantTaskSchedule_status_idx")
  @@index([assignedDate], map: "roomAttendantTaskSchedule_assignedDate_idx")
  @@index([isSentSms], map: "roomAttendantTaskSchedule_isSentSms_idx")
  @@index([deletedAt], map: "roomAttendantTaskSchedule_deletedAt_idx")
  @@map("roomAttendantTaskSchedule")
}

model RoomAttendantAvailability {
  id        String   @id @default(uuid()) @db.Uuid
  clientId  String   @db.Uuid
  client    ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)
  roomAttendantId String   @db.Uuid
  roomAttendant   RoomAttendantProfile @relation(fields: [roomAttendantId], references: [id], onDelete: Cascade)

  fromDate  DateTime
  toDate    DateTime?
  note      String?

  isActive  Boolean  @default(true)
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.Uuid
  updatedBy String?  @db.Uuid
  deletedAt DateTime?

  @@index([clientId], map: "roomAttendantAvailability_clientId_idx")
  @@index([roomAttendantId], map: "roomAttendantAvailability_roomAttendantId_idx")
  @@index([fromDate], map: "roomAttendantAvailability_fromDate_idx")
  @@index([deletedAt], map: "roomAttendantAvailability_deletedAt_idx")
  @@map("roomAttendantAvailability")
}

model SmsGateway {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  domain    String   @unique
  clientProfiles ClientProfile[] @relation("ClientSmsGateway")
  roomAttendantProfiles RoomAttendantProfile[] @relation("RoomAttendantSmsGateway")
  isActive  Boolean  @default(true)
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.Uuid
  updatedBy String?  @db.Uuid
  deletedAt DateTime?

  @@index([deletedAt], map: "smsGateway_deletedAt_idx")
  @@map("smsGateway")
}
