{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ui: server dev",
      "type": "shell",
      "command": "npm run dev:server",
      "cwd": "${workspaceFolder}/..",
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": {
        "owner": "ui-server-dev",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.",
          "endsPattern": "Listening on|EADDRINUSE|Error"
        }
      }
    },
    {
      "label": "ui: vite dev",
      "type": "shell",
      "command": "npm run dev:ui",
      "cwd": "${workspaceFolder}/..",
      "dependsOn": ["ui: server dev"],
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": {
        "owner": "ui-vite-dev",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.",
          "endsPattern": "ready in|Local:|EADDRINUSE|error"
        }
      }
    }
  ]
}
