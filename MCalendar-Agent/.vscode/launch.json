{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug: issue",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--import",
        "tsx/esm",
        "src/index.ts",
        "issue",
        "${input:issueNumber}"
      ],
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal",
      "sourceMaps": true
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug: watch",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--import",
        "tsx/esm",
        "src/index.ts",
        "watch"
      ],
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal",
      "sourceMaps": true
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug: list",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--import",
        "tsx/esm",
        "src/index.ts",
        "list"
      ],
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal",
      "sourceMaps": true
    },
    {
      "type": "node",
      "request": "attach",
      "name": "Debug: server (:3002 breakpoints)",
      "port": 9229,
      "restart": true,
      "skipFiles": ["<node_internals>/**"],
      "preLaunchTask": "agent: server debug (:3002)"
    },
    {
      "type": "chrome",
      "request": "attach",
      "name": "Debug: UI (:3001 attach open browser)",
      "port": 9222,
      "webRoot": "${workspaceFolder}/ui",
      "preLaunchTask": "agent: vite dev (:3001)"
    }
  ],
  "inputs": [
    {
      "id": "issueNumber",
      "description": "GitHub issue number to process",
      "type": "promptString",
      "default": "1"
    }
  ]
}
