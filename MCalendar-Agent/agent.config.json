  "providers": {
    "anthropic": {
      "apiKeyEnv": "ANTHROPIC_API_KEY"
    },
    "openai": {
      "apiKeyEnv": "OPENAI_API_KEY",
      "_comment": "UNCOMMENT src/providers/openai.ts AND registry.ts CASE TO ENABLE"
    },
    "google": {
      "apiKeyEnv": "GOOGLE_API_KEY",
      "_comment": "UNCOMMENT src/providers/google.ts AND registry.ts CASE TO ENABLE"
    },
    "ollama": {
      "baseURL": "http://localhost:11434/v1",
      "model": "llama3.2",
      "_comment": "UNCOMMENT src/providers/ollama.ts AND registry.ts CASE TO ENABLE"
    }
  }
}
