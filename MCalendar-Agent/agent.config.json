      "apiKeyEnv": "GOOGLE_API_KEY",
      "_comment": "UNCOMMENT src/providers/google.ts AND registry.ts CASE TO ENABLE"
    },
    "ollama": {
      "baseURL": "http://localhost:11434/v1",
      "model": "llama3.2",
      "_comment": "UNCOMMENT src/providers/ollama.ts AND registry.ts CASE TO ENABLE"
    }
  }
