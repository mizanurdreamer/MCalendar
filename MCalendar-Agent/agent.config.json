{
  "tasks": {
    "Agent_Analyze_Issue": {
      "provider": "anthropic",
      "model": "claude-sonnet-4-6",
      "maxTokens": 4096,
      "temperature": 0.3
    },
    "Agent_Analyze_Commit": {
      "provider": "anthropic",
      "model": "claude-sonnet-4-6",
      "maxTokens": 4096,
      "temperature": 0.3
    },
    "Agent_Generate_Tests": {
      "provider": "anthropic",
      "model": "claude-sonnet-4-6",
      "maxTokens": 8192,
      "temperature": 0.2
    },
    "Agent_Review_Tests": {
      "provider": "anthropic",
      "model": "claude-sonnet-4-6",
      "maxTokens": 4096,
      "temperature": 0.1
    },
    "Agent_Fix_Tests": {
      "provider": "anthropic",
      "model": "claude-sonnet-4-6",
      "maxTokens": 8192,
      "temperature": 0.2
    },
    "Agent_Summarize": {
      "provider": "anthropic",
      "model": "claude-sonnet-4-6",
      "maxTokens": 2048,
      "temperature": 0.3
    }
