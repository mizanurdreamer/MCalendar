{
  "name": "mcalendar-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "build": "tsc",
    "watch": "tsx watch src/index.ts -- --watch",
    "ui": "npm run build:ui && tsx src/server/main.ts",
    "ui:server": "tsx src/server/main.ts",
    "dev:server": "tsx watch src/server/main.ts",
    "dev:ui": "vite --config ui/vite.config.ts",
    "build:ui": "vite build --config ui/vite.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@google/genai": "^2.17.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@octokit/rest": "^20.1.2",
    "@playwright/mcp": "^0.0.79",
    "chalk": "^4.1.2",
    "commander": "^12.0.0",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "openai": "^4.104.0",
    "pg": "^8.23.0",
    "simple-git": "^3.27.0",
    "winston": "^3.19.0",
    "winston-transport": "^4.9.0",
    "ws": "^8.18.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "dompurify": "^3.2.0",
    "marked": "^14.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^5.4.11"
  }
}
