# -----------------------------------
# ---- OpenRouter Model Name --------
# -----------------------------------
# Free models end with ":free" — MODEL=auto prefers free models automatically.
#
# anthropic/claude-opus-4.1
# anthropic/claude-sonnet-4.5
# openai/gpt-5.4
# google/gemini-2.5-flash
# meta-llama/llama-3.3-70b-instruct
# deepseek/deepseek-chat-v3-0324
#
# meta-llama/llama-3.1-8b-instruct:free
# deepseek/deepseek-r1:free
# qwen/qwen-2.5-72b-instruct:free
#---------------------------------------
# Free models only (account has no credits). Verified working with tool calls:
#   openai/gpt-oss-20b:free, nvidia/nemotron-3-super-120b-a12b:free

# --- AI Provider (anthropic | openai | google | ollama | openrouter) ---
PROVIDER=anthropic

# MODEL behavior:
#   MODEL=auto (or empty) → provider queries its API for available models and uses the FIRST one
#   MODEL=<model-name>    → this exact model is used for ALL tasks
#
# Examples:
#   MODEL=auto
#   MODEL=claude-opus-4-6
#   MODEL=gpt-4o
#   MODEL=gemini-2.5-flash
MODEL=auto

# --- AI Provider Keys ---
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=AIza...
# OPENROUTER_API_KEY=sk-or-...

# --- Ollama (local models — no API key needed) ---
# 1. Start Ollama: run "ollama serve" or launch the Ollama desktop app
# 2. Pull a model: ollama pull llama3.2
# 3. Switch provider: set PROVIDER=ollama above, uncomment below
# PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434/v1

# --- GitHub (needs repo scope for PRs + comments) ---
GITHUB_TOKEN=ghp_...

# --- GitHub Repo (optional if PROJECT_PATH is a git URL) ---
REPO_OWNER=mizanurdreamer
REPO_NAME=MCalendar

# --- Project Path (local path or git URL — name is auto-extracted) ---
PROJECT_PATH=D:\Projects\MCalendar\MCalendar
# PROJECT_PATH=https://github.com/owner/repo

# --- Test Project Path (local path or git URL) ---
TEST_PROJECT_PATH=D:\Projects\MCalendar\MCalendar\E2ETests
# TEST_PROJECT_PATH=https://github.com/owner/repo-tests

# --- Agent Settings ---
AGENT_ENABLED=true
COMMIT_AUTO_APPROVE=true
POLL_INTERVAL_MIN=10
AGENT_MAX_RETRIES=3
AGENT_MAX_ITERATIONS=100
MAX_PIPELINE_STEPS=50
GITHUB_MAX_RETRIES=3
RUN_MAX_RETRIES=1

# --- Branch Watching (optional, can also use --branch CLI flag) ---
WATCH_BRANCH=main

# --- Diagnostic Tools (optional) ---
DATABASE_URL=postgresql://user:pass@localhost:5432/bookingcalendar
API_BASE_URL=http://localhost:3000

# --- Agent Memory (PostgreSQL) ---
# Separate database for agent memory (lessons, patterns, decisions)
# Falls back to DATABASE_URL if not set
# --- Memory Store (local = in-memory, postgres = persistent) ---
AGENT_MEMORY_DATABASE_URL=postgresql://user:pass@localhost:5432/mcalendar_agent
MEMORY_TYPE=persistent

# --- Test Credentials (MCalendar app super admin) ---
SUPER_ADMIN_EMAIL=admin@bookingcalendar.com
SUPER_ADMIN_PASSWORD=Password123!

# --- Playwright MCP (browser automation for agents) ---
# When enabled, agents can explore live apps via browser before writing tests
PLAYWRIGHT_MCP_ENABLED=true
PLAYWRIGHT_MCP_BROWSER=chromium

# --- Playwright MCP Timeout (ms) ---
# Timeout for individual MCP tool calls (browser_navigate, browser_screenshot, etc.)
# Default: 300000 (5 minutes) — increase if browser operations are slow
# MCP_TIMEOUT_MS=300000

# --- Playwright Test Execution ---
# Number of parallel workers for Playwright test runs (default: 1 for test isolation)
PLAYWRIGHT_WORKERS=1

# --- Web UI (npm run ui) ---
WEB_PORT=3002
WEB_HOST=127.0.0.1
