# ═══════════════════════════════════════════════════════════
# MCalendar Multi-AI Test Agent — Environment Configuration
# ═══════════════════════════════════════════════════════════

# --- AI Provider (anthropic | openai | google | ollama) ---
PROVIDER=anthropic
MODEL=auto

# --- AI Provider Keys ---
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=AIza...

# --- GitHub (needs repo scope for PRs + comments) ---
GITHUB_TOKEN=ghp_...

# --- GitHub Repo (optional if PROJECT_PATH is a git URL) ---
REPO_OWNER=mizanurdreamer
REPO_NAME=MCalendar

# --- Project Path (local path or git URL — name is auto-extracted) ---
PROJECT_PATH=D:\Projects\MCalendar\MCalendar
# PROJECT_PATH=https://github.com/owner/repo

# --- Test Project Path (local path or git URL) ---
TEST_PROJECT_PATH=D:\Projects\MCalendar\MCalendar\E2ETests
# TEST_PROJECT_PATH=https://github.com/owner/repo-tests

# --- Agent Settings ---
AGENT_ENABLED=true
COMMIT_AUTO_APPROVE=true
POLL_INTERVAL_MIN=1
AGENT_MAX_RETRIES=3
AGENT_MAX_ITERATIONS=50
MAX_PIPELINE_STEPS=50
GITHUB_MAX_RETRIES=3

# --- Branch Watching (optional, can also use --branch CLI flag) ---
WATCH_BRANCH=main

# --- Diagnostic Tools (optional) ---
DATABASE_URL=postgresql://user:pass@localhost:5432/bookingcalendar
API_BASE_URL=http://localhost:3000

# --- Test Credentials (MCalendar app super admin) ---
SUPER_ADMIN_EMAIL=admin@bookingcalendar.com
SUPER_ADMIN_PASSWORD=Password123!

# --- Playwright MCP (browser automation for agents) ---
MCP_ENABLED=true
MCP_BROWSER=chromium
