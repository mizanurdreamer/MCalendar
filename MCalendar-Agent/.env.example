# ═══════════════════════════════════════════════════════════
# MCalendar Multi-AI Test Agent — Environment Configuration
# ═══════════════════════════════════════════════════════════

# --- AI Provider (anthropic | openai | google | ollama) ---
PROVIDER=anthropic
MODEL=auto

# --- AI Provider Keys ---
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=AIza...

# --- GitHub (needs repo scope for PRs + comments) ---
GITHUB_TOKEN=ghp_...

# --- GitHub Repo (optional if PROJECT_PATH is a git URL) ---
# REPO_OWNER=mizanurdreamer
# REPO_NAME=MCalendar

# --- Project Path (local path or git URL — name is auto-extracted) ---
PROJECT_PATH=D:\Projects\MCalendar\MCalendar
# PROJECT_PATH=https://github.com/owner/repo

# --- Test Project Path (local path or git URL) ---
TEST_PROJECT_PATH=D:\Projects\MCalendar\MCalendar-Tests
# TEST_PROJECT_PATH=https://github.com/owner/repo-tests

# --- Agent Settings ---
AGENT_ENABLED=true
POLL_INTERVAL_MIN=1
MAX_RETRIES=3
MAX_ITERATIONS=20

# --- Branch Watching (optional, can also use --branch CLI flag) ---
# WATCH_BRANCH=main
