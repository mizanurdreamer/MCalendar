# ═══════════════════════════════════════════════════════════
# MCalendar Multi-AI Test Agent — Environment Configuration
# ═══════════════════════════════════════════════════════════

# --- AI Provider (anthropic | openai | google | ollama) ---
PROVIDER=anthropic
MODEL=auto

# --- AI Provider Keys ---
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=AIza...

# --- GitHub (needs repo scope for PRs + comments) ---
GITHUB_TOKEN=ghp_...

# --- Repository ---
REPO_OWNER=mizanurdreamer
REPO_NAME=MCalendar

# --- MCalendar Source Path (for reading code + understanding API routes) ---
PROJECT_PATH=D:\Projects\MCalendar\MCalendar

# --- Test Project Path (where agent writes tests + runs Playwright) ---
TEST_PROJECT_PATH=D:\Projects\MCalendar\MCalendar-Tests

# --- Agent Settings ---
AGENT_ENABLED=true
POLL_INTERVAL_MIN=1
MAX_RETRIES=3

# --- Branch Watching (optional, can also use --branch CLI flag) ---
# WATCH_BRANCH=main
